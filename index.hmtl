<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Madhus Home Bakery</title>

<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #fff8f0;
  color: #4b2e1f;
}

header {
  background: #8b4513;
  color: white;
  text-align: center;
  padding: 30px 15px;
}

header h1 {
  margin: 0;
  font-size: 30px;
}

header p {
  font-size: 18px;
}

section {
  padding: 25px 15px;
}

h2 {
  text-align: center;
  color: #8b4513;
}

.card {
  background: white;
  border-radius: 18px;
  padding: 20px;
  margin: 15px auto;
  max-width: 400px;
  text-align: center;
  box-shadow: 0 3px 10px rgba(0,0,0,0.1);
}

.price {
  font-size: 22px;
  font-weight: bold;
  color: #8b4513;
  margin: 10px;
}

.order,
.call {
  display: inline-block;
  background: #8b4513;
  color: white;
  text-decoration: none;
  padding: 12px 20px;
  border-radius: 25px;
  margin: 5px;
  font-weight: bold;
}

.contact {
  background: #ffe4c4;
  border-radius: 18px;
  text-align: center;
}

footer {
  background: #8b4513;
  color: white;
  text-align: center;
  padding: 22px;
}
</style>
</head>

<body>

<header>
<h1>🍰 Madhus Home Bakery</h1>
<p>Fresh & Homemade with ❤️</p>
</header>

<section>
  <h2>🍰 Our Special Items</h2><div class="products">

  <div class="card">
    <div class="emoji">🍪</div>
    <h3>Cookies</h3>
    <div class="price">₹100</div>
    <a class="order" href="https://wa.me/919347698049" target="_blank">
      Order on WhatsApp
    </a>
  </div>

  <div class="card">
    <div class="emoji">🍫</div>
    <h3>Nutella Bobillones</h3>
    <div class="price">₹100</div>
    <a class="order" href="https://wa.me/919347698049" target="_blank">
      Order on WhatsApp
    </a>
  </div>

</div>
</section><section class="contact">
  <h2>📞 Order Now</h2>
  <p>Call us or order directly on WhatsApp</p>

  <a class="call" href="tel:+919347698049">
    📞 Call: 9347698049
  </a>

  <br>

  <a class="order" href="https://wa.me/919347698049" target="_blank">
    💬 Order on WhatsApp
  </a>
</section>

<footer>
  <p>© 2026 Madhus Home Bakery ❤️</p>
</footer>

</body>
</html>
